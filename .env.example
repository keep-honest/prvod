# Server
# PORT=3000               # Optional: HTTP listen port (default: 3000)
# LOG_LEVEL=              # Optional: "debug" | "info" | "warn" | "error"
#                         # Default: "info" in production, "debug" in development.
#                         # Overrides the default when set.

# Database
DATABASE_URL=             # Postgres connection string (e.g. postgresql://user:pass@host:5432/db)

# ── LLM ─────────────────────────────────────────────────────────────
SCRIPT_WRITER=claude-sdk  # "claude-sdk" (default) | "claude-cli" | "gemini-sdk" | "gemini-cli" | "codex-cli" | "mock"
ANTHROPIC_API_KEY=        # Claude API key (required when SCRIPT_WRITER=claude-sdk)
# GEMINI_API_KEY=         # Google AI Studio key (required when SCRIPT_WRITER=gemini-sdk or SUMMARISER_PROVIDER=gemini-sdk)
#                         # GOOGLE_API_KEY is also accepted as an alias.
# CLAUDE_MODEL=           # Optional: override Claude model (default: claude-sonnet-4-20250514)
# GEMINI_MODEL=           # Optional: override Gemini model (default: gemini-2.5-pro for SDK, gemini-2.5-flash for CLI summariser)
# GEMINI_SCRIPT_MAX_TOKENS=32768  # Optional: max output tokens for gemini-sdk script generation.
#                         # Default is high because Gemini 2.5 Pro's mandatory "thinking" budget
#                         # counts against maxOutputTokens — internal reasoning regularly consumes
#                         # 8–16k before any visible output. Dial down for non-thinking Flash deployments.
# GEMINI_RETIME_MAX_TOKENS=16384  # Optional: max output tokens for gemini-sdk narration retime.
# GEMINI_SUMMARISER_MAX_TOKENS=4096  # Optional: max output tokens for gemini-sdk oversized-file summariser.
#                         # Higher than the 1024 client default because Gemini 2.5's thinking budget
#                         # eats most of a 1024 budget; combined with thinkingBudget=0 (set in code
#                         # for this path) this gives ~4096 usable tokens for the summary.
# CODEX_MODEL=            # Optional: override Codex model (default: o4-mini)
#                         # GPT-5 family options (recommended over o4-mini for speed/cost):
#                         #   gpt-5       — highest quality ($1.25/$10.00 per MTok), 400K context
#                         #   gpt-5.4-nano — latest gen ($0.20/$1.25 per MTok), 400K context
#                         #   gpt-5.4-mini — latest gen ($0.75/$4.50 per MTok), 400K context
# CODEX_REASONING_EFFORT= # Optional: reasoning effort for Codex models (default: medium)
#                         # Values: low, medium, high (some models also support xhigh)
#                         # "medium" is the safe default — works with all models
# SCRIPT_DURATION_GUARD_COEFFICIENT=1.4
#                         # Script duration guard tolerance. Prompts still ask for the mode target
#                         # (short 60s, default 120s, popcorn 320s), but post-generation guards
#                         # allow target * coefficient before retry/fail.

# ── TTS ──────────────────────────────────────────────────────────────
USE_BUILTIN_TTS=false     # true = use built-in TTS, false = use Google Cloud TTS
TTS_PROVIDER=google       # "google" (default) | "mock" for external-TTS mocking in non-production
GOOGLE_CLOUD_TTS_KEY=     # Google Cloud TTS API key (required only when external TTS is actually used)
# GOOGLE_TTS_VOICE=       # Optional: global TTS voice override (default: en-US-Chirp3-HD-Algenib).
#                         # Valid families: Neural2, WaveNet, Studio, Chirp HD, Chirp3 HD.
#                         # Examples: en-US-Neural2-D | en-US-Studio-Q | en-US-Chirp3-HD-Orus
# TTS_SPEED_MULTIPLIER=   # Optional: scales the computed speaking rate (default: 1.0).
#                         # Values > 1.0 speed up narration, < 1.0 slow it down.
#                         # Example: 1.2 = 20% faster speech, 0.8 = 20% slower.
#                         # Must be positive. Invalid values fall back to 1.0.
# GOOGLE_TTS_TIMEOUT_MS=45000          # Per-attempt Google TTS API timeout.
# GOOGLE_TTS_MAX_ATTEMPTS=3            # Max attempts per scene TTS call. Set to 1 to disable retries.
# GOOGLE_TTS_RETRY_BASE_DELAY_MS=1000  # First backoff delay before retrying transient TTS failures.
# GOOGLE_TTS_RETRY_MAX_DELAY_MS=10000  # Max individual backoff delay for TTS retries.

# ── Storage ──────────────────────────────────────────────────────────
STORAGE_PROVIDER=r2       # "r2" (default) | "s3" | "local"
# USE_LOCAL_STORAGE=true  # Deprecated shorthand — equivalent to STORAGE_PROVIDER=local
# LOCAL_STORAGE_DIR=      # Optional: override local storage path (default: .local-storage)
# STORAGE_URL_SECRET=     # Required when STORAGE_PROVIDER=local. HMAC secret for signing
#                         # local-storage URLs served by /api/local-storage/*. Rotating it
#                         # immediately invalidates all outstanding video links.
#                         # Generate with: openssl rand -hex 32

# Cloudflare R2  (only when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=            # Cloudflare account ID
R2_ACCESS_KEY_ID=         # R2 access key
R2_SECRET_ACCESS_KEY=     # R2 secret key
R2_BUCKET_NAME=           # R2 bucket name
# R2_PATH=               # Optional path prefix — objects stored at <bucket>/<R2_PATH>/<key>
R2_PUBLIC_URL=            # Optional public URL prefix for the bucket

# AWS S3  (only when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=        # AWS access key ID
AWS_SECRET_ACCESS_KEY=    # AWS secret access key
AWS_REGION=               # AWS region (e.g. us-east-1)
AWS_S3_BUCKET_NAME=       # S3 bucket name
# AWS_S3_PATH=            # Optional path prefix — objects stored at <bucket>/<AWS_S3_PATH>/<key>
# AWS_S3_ENDPOINT=        # Optional: custom endpoint for S3-compatible services (MinIO, Backblaze B2, etc.)

# ── Captions ────────────────────────────────────────────────────────
# CAPTION_OFFSET_MS=        # Optional: shift all captions by N milliseconds (default: 0).
#                           # Positive = delay captions (audio leads), negative = advance.
#                           # Useful for fine-tuning caption sync per deployment/model.

# ── Video Compositor ───────────────────────────────────────────────
VIDEO_COMPOSITOR=ffmpeg    # "ffmpeg" (default) | "remotion"
#                          # ffmpeg: native ffmpeg rendering (fast, ~50MB, no Chromium)
#                          # remotion: React/Chromium rendering (pixel-perfect CSS, ~1.5GB)
# REMOTION_RENDERER_PORT=3300  # Internal Remotion renderer server port.
#                              # Use a fixed non-3000 port to avoid Render/Next port collisions.
# REMOTION_RENDER_TIMEOUT_MS=600000  # Hard deadline for a single render section (default 10 min).
#                                    # Wedged browser → RemotionRenderTimeoutError + lock release.

# ── Script Repair ─────────────────────────────────────────────────
# SCRIPT_REPAIR_MAX_ATTEMPTS=2  # Max LLM repair attempts when generated script
#                                # fails Zod validation or evidence grounding.
#                                # Set to 0 to disable. Applies to both schema
#                                # repair and grounding repair loops.

# ── Signed URLs ──────────────────────────────────────────────────────
SIGNED_URL_EXPIRY_HOURS=4 # Default signed URL expiry (hours)

# ── GitHub App (recommended) ──────────────────────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new
#   Permissions: Contents (R), Pull requests (R/W), Issues (R/W), Metadata (R)
#   Events: pull_request, issue_comment, installation, installation_repositories
GITHUB_APP_ID=            # Numeric App ID
GITHUB_APP_PRIVATE_KEY=   # RSA private key PEM — literal \n between lines
#   Generate: openssl genrsa 2048 | tr '\n' '\\n'
GITHUB_APP_SLUG=          # App slug (e.g. prvod) — prevents bot comment loops
GITHUB_APP_WEBHOOK_SECRET=# Webhook secret for App mode

# ── Share link signing (for /watch/[jobId] public viewer) ──────────
# Server-side only — recipients do NOT need this secret.
# When a /watch URL is generated, the server signs a token with this secret;
# when a recipient opens the URL, the server verifies the token. Tokens that
# fail verification (missing, expired, tampered) get a generic "Link Expired"
# page instead of the video.
#   Generate: openssl rand -hex 32
SHARE_SIGNING_SECRET=

# ── Review workstation GitHub sign-in (draft-comment sync/submit) ─────
# Viewing review pages stays share-token gated; a GitHub session only
# unlocks drafting + submitting PR review comments from the workstation.
# AUTH_SECRET: NextAuth JWT/session encryption secret.
#   Generate: openssl rand -base64 32
AUTH_SECRET=
# OAuth client credentials of the GitHub App above
# (GitHub App settings → "Client ID" / "Generate a new client secret").
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
#
# Mock services (for local dev/testing — runs entire pipeline without external APIs)
# USE_MOCK_SERVICES=true             # Wire all services to in-memory mocks (overrides individual providers)

# ── API Key security ──────────────────────────────────────────────────
# Only needed for the non-production /api/jobs routes and local CLI tooling.
# APP_ENCRYPTION_KEY: Pepper added to all API key Argon2id hashes.
#   Generate: openssl rand -hex 32
#   Changing this invalidates all existing keys — rotate after change.
APP_ENCRYPTION_KEY=       # 32-byte hex pepper
#
# New keys: scripts/create-admin-api-key.ts
# Legacy: API_SECRET_KEY still accepted for local/manual compatibility.
API_SECRET_KEY=           # [DEPRECATED] Shared secret for local API auth

# ── Feature Flags ───────────────────────────────────────────────────
PROMPT_PIPELINE_V2=true           # Enable multi-step V2 prompt pipeline (coverage plan → scene outline → judges → script)
MODEL_PROMPT_ADAPTERS_V1=true     # Enable model-specific prompt adapters (structured promptSegments, negativePrompt, nativeAudioDirective)
PROMPT_PIPELINE_V2_COMPARE_V1=true # Run both V1 and V2 pipelines side-by-side and log a metrics comparison
# BATCH_SCENE_GENERATION=false    # When true, generate final script in small sequential batches
#                                 # (2-3 scenes each) instead of a single monolithic LLM call.
# GROUNDING_FAILURE_WARN=false    # When true, treat evidence grounding validation failures as
#                                 # warnings instead of fatal errors. Useful for weaker models
#                                 # (e.g. Gemini Flash) that struggle with cross-reference constraints.
# POST_GROUNDING=false            # When true, re-run the narration judge after a successful
#                                 # grounding repair to restore narrative quality that edits
#                                 # may have degraded. Adds 1-3 extra LLM calls when grounding
#                                 # repair fires. Disabled by default for latency.
# REVIEWER_VIOLATION_WARN=false   # When true, treat deepdive reviewer narration validation
#                                 # failures (verdict language, client-facing tone) as warnings
#                                 # instead of fatal errors. Standard mode ignores this.
# SKIP_JUDGE=false                # When true, bypass ALL AI judges in the pipeline:
#                                 #   - Visual prompt judge (step 2b)
#                                 #   - Coverage judge (V2 stage 2/7)
#                                 #   - Narration quality judge (V2 stage 5/7)
#                                 # Deterministic validators (coverage consistency, word budgets,
#                                 # evidence grounding) still run. Useful for local iteration,
#                                 # cost-sensitive environments, and debugging.

# ── LLM call retry (transient errors: 429, RESOURCE_EXHAUSTED, 5xx) ─
# LLM_MAX_RETRIES=5               # Max attempts per LLM call before giving up (default: 5).
#                                 # Each call (not the whole pipeline) is retried with exponential
#                                 # backoff + jitter. When exhausted, the pipeline fails with
#                                 # errorCode=LLM_RATE_LIMITED_EXHAUSTED and a dedicated PR
#                                 # comment is posted. Set to 1 to disable retries.
# LLM_RETRY_BASE_DELAY_MS=1000    # Base delay (ms) for the first backoff. Each subsequent attempt
#                                 # doubles (capped at 30s) with ±50% jitter. Default: 1000.

# ── Diff Pagination & Oversized-File Summariser ─────────────────────
# SUMMARISER_PROVIDER=             # Oversized-file summariser backend:
#                                 # "claude-sdk" | "claude-cli" | "gemini-sdk" | "gemini-cli" | "codex-cli" | "mock".
#                                 # When unset, inherits SCRIPT_WRITER (so claude-cli script writers
#                                 # do not require an ANTHROPIC_API_KEY for summarisation).
#                                 # Set to "mock" for local testing without any LLM call.
# CLAUDE_SUMMARISER_MODEL=claude-haiku-4-5-20251001
#                                 # Model for claude-sdk or claude-cli summariser (default: claude-haiku-4-5-20251001).
#                                 # Use a small, fast model to keep costs low.
# GEMINI_SUMMARISER_MODEL=gemini-2.5-flash
#                                 # Model for gemini-sdk or gemini-cli summariser (default: gemini-2.5-flash).
# CODEX_SUMMARISER_MODEL=o4-mini  # Model for codex-cli summariser (default: o4-mini).
# CLI_GIT_MAX_BUFFER_MB=64        # Max buffer (MB) for git diff commands in local CLI (default: 64).
#                                 # Increase if your repo has very large diffs.
