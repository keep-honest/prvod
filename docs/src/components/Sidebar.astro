---
import Default from "@astrojs/starlight/components/Sidebar.astro";
---

<button
  type="button"
  id="prvod-sidebar-toggle"
  class="prvod-sidebar-toggle"
  aria-label="Toggle navigation sidebar"
  aria-controls="starlight__sidebar"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
    <line x1="9" y1="3" x2="9" y2="21"></line>
  </svg>
</button>

<div class="prvod-sidebar-inner">
  <Default><slot /></Default>
</div>

<script is:inline>
  (() => {
    const KEY = "prvod-sidebar-collapsed";
    const root = document.documentElement;
    const apply = (collapsed) => {
      root.toggleAttribute("data-sidebar-collapsed", collapsed);
    };
    apply(localStorage.getItem(KEY) === "1");

    document.addEventListener("click", (e) => {
      const btn = e.target.closest("#prvod-sidebar-toggle");
      if (!btn) return;
      const next = !root.hasAttribute("data-sidebar-collapsed");
      apply(next);
      localStorage.setItem(KEY, next ? "1" : "0");
      btn.setAttribute("aria-expanded", String(!next));
    });
  })();
</script>
